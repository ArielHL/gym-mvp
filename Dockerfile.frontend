FROM node:22-bookworm-slim

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global eas-cli@latest

EXPOSE 8081 19000 19001 19002

CMD ["bash", "-lc", "npm ci && npm run start -- --host lan"]
