.mypy_cache/
.ruff_cache/

# Firebase functions package: separate package, not needed for Expo app build
functions/
firebase.json
.firebaserc

# Supabase local/dev files: remote Supabase is used at runtime
supabase/
seed/

# Generated Expo/native artifacts
expo-env.d.ts
android/app/debug.keystore
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.iml
android/.idea/
android/.cxx/

# Optional: ignore native folders for cloud EAS managed/prebuild builds
# Keep these ignored if EAS should regenerate native projects.
android/
ios/