{
  "expo": {
    "name": "Gym Mobile MVP",
    "slug": "gym-mobile-mvp",
    "scheme": "gymmobilemvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.gymmobilemvp"
    },
    "android": {
      "package": "com.example.gymmobilemvp"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Oi-Regular.ttf",
            "./assets/fonts/Manrope.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "0c4530cb-a729-4859-a1c4-8bade42cf409"
      }
    }
  }
}
